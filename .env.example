# Copy to `.env` and fill in locally. `.env` is git-ignored: never commit it.
# Only variable NAMES live here; no values, not even fake ones.

# Chat model provider (any OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings backend: variables added when ADR 0003 is accepted (M1).

# Local Postgres + pgvector (docker-compose.yml). Used by compose and by lore.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
